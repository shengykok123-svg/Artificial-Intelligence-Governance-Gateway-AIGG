# Base URL of the FastAPI backend (M0+M1). Default matches `uvicorn` locally.
VITE_API_BASE=http://localhost:8000

# Must match backend/.env's API_KEY, or every request 403s.
VITE_API_KEY=dev-key-change-me

# true starts the MSW mock service worker instead of hitting the real API --
# the offline fallback, never the default. Leave false to develop/demo
# against the live backend.
VITE_USE_MSW=false

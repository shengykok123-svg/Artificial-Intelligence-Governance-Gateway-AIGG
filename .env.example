# One connection string drives local and hosted alike. The code never knows
# which it is talking to -- that is why a hosted prototype link is a config
# change and not a project.
DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway

# memory | postgres
# Default is memory: nobody working on M1 or M6 needs Docker running.
REPO_BACKEND=memory

# Used by the pytest suite to create/drop a throwaway database per session.
TEST_DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/postgres

# Modules not yet built, served by app/mocks.py. Remove each ID as it lands.
# Explicit list, never a try/except ImportError fallback: a broken real module
# must fail loudly, not silently fall back to a mock.
MOCK_MODULES=

# Anti-shadow-AI: a hold nobody reviews auto-downgrades to its prepared
# redaction after this many seconds (lazy, evaluated on the next status
# poll -- no scheduler). 0 disables the downgrade.
HOLD_TIMEOUT_SECONDS=600

# m8 (default) | m9_deberta | both. M9 is opt-in and requires saved artifacts
# from backend/ml/m9_train.py; it keeps the same Detector / DocumentClassifier
# contract as M8. "both" runs M8 and M9 in parallel (backend/app/detect/composite.py)
# -- complementary, not interchangeable: M8 catches paraphrases of a specific
# indexed internal document, M9 catches novel confidential content that
# matches nothing in the index. Both are real modules; "both" fails loudly at
# first use if M9's weights are missing, same as m9_deberta alone.
SEMANTIC_DETECTOR=m8
M9_MODEL_DIR=artifacts/deberta-m9-detector
M9_CONFIDENCE_THRESHOLD=0.65

# M8's confidence is a cosine similarity; M9's is a joint department+
# sensitivity head probability -- NOT the same scale. The policy rule
# table's min_confidence (e.g. 0.65 / 0.85 on DEPT_CONFIDENTIAL) gates
# whatever confidence a span carries identically regardless of which
# detector emitted it, so calibration has to happen HERE, at each
# detector's own emission threshold, not in the rule table.
#
# Calibration procedure: run both detectors over the gold eval set
# (backend/ml gold data) and pick per-detector thresholds such that a span
# emitted at confidence c reflects comparable precision from either
# detector. Only once M8_SPAN_THRESHOLD/M8_CLASSIFY_THRESHOLD and
# M9_CONFIDENCE_THRESHOLD are calibrated against the same eval set do the
# rule table's 0.65/0.85 tiers mean one consistent thing in "both" mode.
M8_SPAN_THRESHOLD=0.72
M8_CLASSIFY_THRESHOLD=0.40

# dev | demo. ENV=demo with a non-empty MOCK_MODULES refuses to start, so a
# demo video can never be recorded against redaction that never happened.
ENV=dev
API_KEY=dev-key-change-me

# M7: generate a local value with Fernet.generate_key(); never commit a real key.
VAULT_FERNET_KEY=

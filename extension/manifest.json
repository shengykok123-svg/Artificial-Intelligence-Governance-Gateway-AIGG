{
  "manifest_version": 3,
  "name": "AI Governance Gateway",
  "version": "0.1.0",
  "description": "Redacts, holds or blocks sensitive prompts before they reach ChatGPT or Gemini.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AI Governance Gateway"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["src/mainworld.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
